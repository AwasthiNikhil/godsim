+/// Largest body that can enter deep water. [Provisional], S0 tuning.
+pub const DEEP_WATER_MAX_SIZE: Fx = Fx::ONE;
+
+/// Refuges (habitat variety, validation_plan.md S0-lite "fail → reconsider"):
+/// - deep water admits only small bodies, so large hunters cannot follow prey there;
+/// - highland admits only creatures whose temperature tolerance covers the cell's temperature,
+///   so warm-adapted hunters cannot follow cold-adapted prey uphill.
+fn can_enter(c: &Creature, cell: usize, env: &Environment, sat: &mut Sat) -> bool {
+    match env.habitat[cell] {
+        Habitat::DeepWater => c.genome.size <= DEEP_WATER_MAX_SIZE,
+        Habitat::Highland => {
+            let off = sat.sub(env.temperature[cell], c.genome.temp_opt);
+            Fx::from_raw(off.raw().abs()) <= c.genome.temp_tol
+        }
+        _ => true,
+    }
+}
